# Local Docker Compose values. Copy this to .env and adjust for cloud
# managed services (Neon/Supabase, Qdrant Cloud) when deploying.

ENVIRONMENT=local

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pr_reviewer

CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

# Used to sign the session cookie that keeps you logged in. Any long
# random string works locally; use a real secret in production.
SESSION_SECRET_KEY=dev-only-secret-change-me

# From a GitHub OAuth App: Settings > Developer settings > OAuth Apps.
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Not used until the indexing and agent phases. Left here so switching
# providers later is an env var change, not a code change.
QDRANT_URL=
QDRANT_API_KEY=
GROQ_API_KEY=
