# Local Docker Compose values. Copy this to .env and adjust for cloud free
# tier services (Neon/Supabase, Qdrant Cloud) when deploying.

ENVIRONMENT=local

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pr_reviewer

CORS_ORIGINS=["http://localhost:3000"]

# Not used until the indexing and agent phases. Left here so switching
# providers later is an env var change, not a code change.
QDRANT_URL=
QDRANT_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=
